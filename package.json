{
  "name": "phonon-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Démo des modèles Phonon de Gradium : inférence Node.js côté serveur, front React.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev:server": "node --watch-path=server --watch-path=shared server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "tsc -p tsconfig.json && vite build --config web/vite.config.ts",
    "start": "NODE_ENV=production node server/index.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "phonon-tts": "^0.4.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
