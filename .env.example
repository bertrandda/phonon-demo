# Token Hugging Face (lecture) du compte qui a accepté les conditions des modèles phonon-40m-*
# https://huggingface.co/settings/tokens
HF_TOKEN=

PORT=3000
HOST=127.0.0.1
# Où les modèles et les voix sont téléchargés
MODELS_DIR=./.models
# Nombre de configurations de modèle gardées en mémoire (une par worker)
MAX_LOADED_MODELS=3
